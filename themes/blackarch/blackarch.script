# BlackArch Plymouth animation.
#
# The artwork is a 24-frame, 10 fps loop. The animation and progress bar are
# laid out as one centred unit and are only scaled down when the display is too
# small. The 360 px animation area leaves room for its smoke and embers while
# matching the overall height and visual scale of the static themes.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

animation.images[0]  = Image("frames/frame-00.png");
animation.images[1]  = Image("frames/frame-01.png");
