# The complete unscaled layout is 500x410: a 360 px animation, 18 px gap, and
# the padded 32 px bar. Reserve 4% at every edge and never enlarge the artwork.
layout.scale = 1;
layout.width_limit = Window.GetWidth() * 0.96;
layout.height_limit = Window.GetHeight() * 0.96;
if (500 * layout.scale > layout.width_limit)
  layout.scale = layout.width_limit / 500;
if (410 * layout.scale > layout.height_limit)
  layout.scale = layout.height_limit / 410;

if (layout.scale < 1)
  {
    layout.frame_width = Math.Int(360 * layout.scale);
    layout.frame_height = Math.Int(360 * layout.scale);
    layout.bar_width = Math.Int(500 * layout.scale);
    layout.bar_height = Math.Int(32 * layout.scale);
    for (index = 0; index < 24; index++)
      animation.images[index] = animation.images[index].Scale(layout.frame_width, layout.frame_height);
    for (index = 0; index < 51; index++)
      progress.images[index] = progress.images[index].Scale(layout.bar_width, layout.bar_height);
  }
else
  {
    layout.frame_width = 360;
    layout.frame_height = 360;
    layout.bar_width = 500;
    layout.bar_height = 32;
  }

layout.gap = Math.Int(18 * layout.scale);
layout.height = layout.frame_height + layout.gap + layout.bar_height;
layout.top = Window.GetY() + Window.GetHeight() / 2 - layout.height / 2;

animation.sprite = Sprite(animation.images[0]);
animation.x = Window.GetX() + Window.GetWidth() / 2 - layout.frame_width / 2;
animation.y = layout.top;
animation.sprite.SetPosition(animation.x, animation.y, 10);
animation.index = 0;
animation.phase = 0;

progress.sprite = Sprite(progress.images[0]);
progress.x = Window.GetX() + Window.GetWidth() / 2 - layout.bar_width / 2;
progress.y = layout.top + layout.frame_height + layout.gap;
progress.sprite.SetPosition(progress.x, progress.y, 20);
progress.index = 0;

status = "normal";

fun refresh_callback ()
  {
    if (status == "normal")
      {
        # Plymouth refreshes at 50 Hz. Advancing by 10/50 produces a restrained
        # 10 fps ring rotation and a complete loop of roughly 2.4 seconds.
        animation.phase += 0.20;
        if (animation.phase >= 1)
          {
            animation.phase = animation.phase - 1;
            animation.index++;
            if (animation.index >= 24)
              animation.index = 0;
            animation.sprite.SetImage(animation.images[animation.index]);
          }
      }
  }

fun progress_callback (duration, fraction)
  {
    local.index = Math.Int(fraction * 50);
    if (local.index < 0)
      local.index = 0;
    if (local.index > 50)
      local.index = 50;
    if (local.index != progress.index)
      {
        progress.index = local.index;
        progress.sprite.SetImage(progress.images[progress.index]);
      }
  }

fun dialog_setup ()
  {
    dialog.entry_image = Image("dialog/entry.png");
    dialog.lock_image = Image("dialog/lock.png");
    dialog.bullet_image = Image("dialog/bullet.png");
    dialog.entry_sprite = Sprite(dialog.entry_image);
    dialog.lock_sprite = Sprite(dialog.lock_image);
    dialog.x = Window.GetX() + Window.GetWidth() / 2 -
               (dialog.entry_image.GetWidth() + dialog.lock_image.GetWidth()) / 2;
    dialog.y = Window.GetY() + Window.GetHeight() / 2 - dialog.entry_image.GetHeight() / 2;
    dialog.lock_sprite.SetPosition(dialog.x, dialog.y, 100);
    dialog.entry_sprite.SetPosition(dialog.x + dialog.lock_image.GetWidth(), dialog.y, 100);
  }

fun dialog_opacity (opacity)
  {
    dialog.entry_sprite.SetOpacity(opacity);
    dialog.lock_sprite.SetOpacity(opacity);
    for (index = 0; dialog.bullets[index]; index++)
      dialog.bullets[index].sprite.SetOpacity(opacity);
  }

fun display_normal_callback ()
  {
    global.status = "normal";
    animation.sprite.SetOpacity(1);
    progress.sprite.SetOpacity(1);
    if (global.dialog)
      dialog_opacity(0);
  }

fun display_password_callback (prompt, bullets)
  {
    global.status = "password";
    animation.sprite.SetOpacity(0.20);
    progress.sprite.SetOpacity(0.20);
    if (!global.dialog)
      dialog_setup();
    else
      dialog_opacity(1);

    for (index = 0; dialog.bullets[index] || index < bullets; index++)
      {
        if (!dialog.bullets[index])
          {
            dialog.bullets[index].sprite = Sprite(dialog.bullet_image);
            dialog.bullets[index].x = dialog.x + dialog.lock_image.GetWidth() +
                                      18 + index * dialog.bullet_image.GetWidth();
            dialog.bullets[index].y = dialog.y + dialog.entry_image.GetHeight() / 2 -
                                      dialog.bullet_image.GetHeight() / 2;
            dialog.bullets[index].sprite.SetPosition(dialog.bullets[index].x,
                                                     dialog.bullets[index].y, 101);
          }
        if (index < bullets)
          dialog.bullets[index].sprite.SetOpacity(1);
        else
          dialog.bullets[index].sprite.SetOpacity(0);
      }
  }

message.sprite = Sprite();
message.sprite.SetPosition(0, 0, 200);

fun display_message_callback (text)
  {
    message.image = Image.Text(text, 0.82, 0.82, 0.82);
    message.sprite.SetImage(message.image);
    message.sprite.SetOpacity(1);
    message.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - message.image.GetWidth() / 2);
    message.sprite.SetY(Window.GetY() + Window.GetHeight() * 0.94 - message.image.GetHeight());
  }

fun hide_message_callback (text)
  {
    message.sprite.SetOpacity(0);
  }

fun quit_callback ()
  {
    progress.index = 50;
    progress.sprite.SetImage(progress.images[50]);
  }

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetBootProgressFunction(progress_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
Plymouth.SetQuitFunction(quit_callback);
