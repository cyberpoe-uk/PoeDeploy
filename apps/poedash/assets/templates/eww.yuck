;; PoeDash general workstation overview. Collectors live in scripts/.
(defpoll clock :run-while home_visible :interval "10s" :initial "--:--" `date '+%H:%M'`)
(defpoll today :run-while home_visible :interval "30s" :initial "" `LC_ALL=C date '+%a %d %b' | tr '[:lower:]' '[:upper:]'`)
(defpoll month :run-while home_visible :interval "1m" :initial "" `LC_ALL=C date '+%B %Y'`)
(deflisten home_visible :initial true `./scripts/workspace.py --listen`)
(defvar cpu 0)
(defvar ram 0)
(defvar gpu '{"usage":0,"label":"--","temperature":"--"}')
(defvar network '{"interface":"--","ip":"--","tailscale":"--","state":"Offline"}')
(defvar vpn '{"summary":"Checking VPNs","count":"0","tailscale_state":"Checking","proton_state":"Checking"}')
(defvar arch '{"kernel":"--","uptime":"--"}')
(defpoll packages :run-while home_visible :interval "30m" :initial "--" `./scripts/arch-status.sh packages`)
(defpoll updates :run-while home_visible :interval "30m" :initial "--" `./scripts/arch-status.sh updates`)
(defpoll calendar_text :run-while home_visible :interval "1m" :initial "" `./scripts/calendar.sh`)
(defpoll calendar_events :run-while home_visible :interval "1m" :initial '{"connected":false,"status":"Checking Thunderbird calendars","events":[]}' `./scripts/thunderbird-calendar.py`)
(defpoll system_info :run-while home_visible :interval "5m" :initial '{"host":"--","os":"--","kernel":"--","cpu":"--","gpu":"--","memory":"--","disk":"--","load":"--"}' `./scripts/system-info.py`)
(defvar power_tab "idle")
(defvar power '{"present":false,"on_battery":false,"available":false,"watts":"--","battery":"--","status":"--","remaining":""}')
(defvar processes '[{"name":"Collecting process data","pid":"","cpu":"","memory":""}]')
(defvar shares '["Checking mounted shares"]')
(defvar media '{"available":false,"player":"No media","title":"Nothing playing","artist":"","status":"Stopped","position":"0:00","length":"0:00","progress":0,"icon":"♪","art":""}')
;; Start with narrow geometry until the monitor listener reports the actual size.
(defvar layout '{"density": "comfortable", "columns": 0, "gap": 4, "row_gap": 4, "padding": 6, "rail_width": 44, "rail_labels": false, "rail_content_width": 24, "app_name_size": 9, "rail_name_chars": 3, "card_width": 232, "card_padding": 10, "arch_height": 40, "system_height": 40, "calendar_height": 40, "performance_height": 40, "processes_height": 40, "connectivity_height": 40, "player_height": 40, "shares_height": 40, "management_height": 40, "header_height": 59, "top_height": 40, "middle_height": 40, "bottom_height": 40, "list_height": 20, "share_height": 20, "power_height": 20, "font_size": 11, "small_size": 9, "heading_size": 13, "title_size": 23, "media_title_size": 15, "media_control": 34, "album_size": 28, "media_text_width": 188, "process_name_chars": 24, "key_width": 51, "calendar_size": 9, "calendar_inline": true, "month_width": 120, "agenda_width": 108, "agenda_height": 30, "hostname_width": 18, "stat_key_chars": 15, "text_width": 17, "hostname": "Loading\u2026", "grid": "(box)"}')
(deflisten dashboard_grid :initial "(box)" `exec ./scripts/layout.py listen`)

(deflisten refresh_status :initial "starting" `exec ./scripts/refresh.py`)

(deflisten power_profile :initial '{"supported":false,"source":"unknown","active":"Unavailable","available":[],"mode":"Unavailable","enabled":false,"message":"Checking power profiles"}' `exec ./scripts/power-control.py listen`)

(deflisten idle :initial '{"screen":0,"lock":0,"suspend":0,"dirty":false,"supported":false,"known":false,"message":"Detecting idle manager","config":""}' `exec ./scripts/idle-control.py listen`)

(deflisten app_lists :initial '{"pinned":[],"recent":[]}' `./scripts/desktop.py listen`)

(defwidget section-title [text]
  (label :show-truncated false :class "card-title" :style "font-size: ${layout.heading_size}px;" :text text :halign "start"))

(defwidget stat-row [name value]
  (box :space-evenly false :spacing 10 :hexpand true :vexpand true
    (label :show-truncated false :class "stat-name" :text name :halign "start" :hexpand true :limit-width {layout.stat_key_chars} :tooltip name)
    (label :class "stat-value" :text value :halign "end" :limit-width {layout.text_width} :tooltip value)))

(defwidget info-row [name value]
  (box :space-evenly false :spacing 10 :vexpand true
    (label :show-truncated false :class "info-key" :style "font-size: ${layout.small_size}px;" :text name :width {layout.key_width} :height 0 :halign "start")
    (label :show-truncated false :class "info-value" :xalign 0 :text value :halign "start" :hexpand true :width {layout.card_width - layout.key_width - 10} :height 0 :wrap true :tooltip value)))

(defwidget meter [name value display action]
  (button :onclick action
    (box :space-evenly false :spacing 10 :class "meter-row" :style "min-height: ${layout.font_size + 6}px;" :vexpand true
      (label :show-truncated false :class "stat-name" :text name :width 36 :halign "start")
      (progress :value value :hexpand true :valign "center")
      (label :class "stat-value" :text display :width 56 :xalign 1))))

(defwidget arch-card [height]
  (box :class "card arch-card" :style "padding: ${layout.card_padding}px;" :vexpand true :orientation "v" :space-evenly false :spacing {layout.row_gap} :width {layout.card_width} :height {height - 2 * layout.card_padding - 4}
    (section-title :text "ARCH")
    (stat-row :name "Kernel" :value {arch.kernel})
    (stat-row :name "Uptime" :value {arch.uptime})
    (stat-row :name "Packages" :value packages)
    (button :onclick "./scripts/launch.sh updates" :tooltip "Check Arch repository updates"
      (box :class {updates == "0" ? "updates current" : updates == "--" ? "updates unknown" : updates > 50 ? "updates critical" : "updates pending"}
        (stat-row :name "Updates" :value updates)))))

(defwidget system-card [height]
  (box :class "card system-card" :style "padding: ${layout.card_padding}px;" :vexpand true :tooltip "SYSTEM SPECIFICATIONS" :orientation "v" :space-evenly false :spacing {layout.row_gap} :width {layout.card_width} :height {height - 2 * layout.card_padding - 4}
    (section-title :text "SYSTEM")
    (info-row :name "OS" :value {system_info.os})
    (info-row :name "CPU" :value {system_info.cpu})
    (info-row :name "GPU" :value {system_info.gpu})
    (info-row :name "MEMORY" :value {system_info.memory})
    (info-row :name "HOME DISK" :value {system_info.disk})))

(defwidget calendar-card [height]
  (button :timeout "15s" :onclick "./scripts/desktop.py calendar" :tooltip "Open Thunderbird Calendar"
    (box :class "card calendar-card" :style "padding: ${layout.card_padding}px;" :vexpand true :orientation "v" :space-evenly false :spacing {layout.row_gap} :width {layout.card_width} :height {height - 2 * layout.card_padding - 4}
      (section-title :text "CALENDAR")
      (box :orientation {layout.calendar_inline ? "h" : "v"} :space-evenly false :spacing {layout.gap} :vexpand true
        (box :orientation "v" :space-evenly false :spacing 6 :width {layout.calendar_inline ? layout.month_width : layout.card_width} :height 0
          (label :show-truncated false :class "calendar-month" :text month :halign "start")
          (label :show-truncated false :class "calendar-text" :style "font-size: ${layout.calendar_size}px;" :markup calendar_text :unindent false :halign "center" :valign "start"))
        (box :orientation "v" :space-evenly false :spacing {layout.row_gap} :width {layout.agenda_width} :height 0 :vexpand true
          (label :show-truncated false :class "subheading" :text "UPCOMING" :style "font-size: ${layout.small_size}px;" :halign "start")
          (label :show-truncated false :class "calendar-status" :text {calendar_events.status} :width {layout.agenda_width} :height 0 :wrap true :xalign 0 :style "font-size: ${layout.small_size}px;")
          (scroll :hscroll false :vscroll true :width 0 :height {layout.agenda_height} :vexpand true
            (box :orientation "v" :space-evenly false :spacing {layout.row_gap}
              (for event in {calendar_events.events}
                (box :class "calendar-event" :orientation "v" :space-evenly false :spacing 4 :tooltip {event.calendar}
                  (label :show-truncated false :class "event-time" :text {event.when} :halign "start" :style "font-size: ${layout.small_size}px;")
                  (label :show-truncated false :text {event.title} :width {layout.agenda_width} :height 0 :wrap true :xalign 0))))))))))

(defwidget performance-card [height]
  (box :class "card metrics-card" :style "padding: ${layout.card_padding}px;" :vexpand true :orientation "v" :space-evenly false :spacing {layout.row_gap} :width {layout.card_width} :height {height - 2 * layout.card_padding - 4}
    (button :onclick "./scripts/launch.sh system" :tooltip "Open btop" (section-title :text "PERFORMANCE"))
    (meter :name "CPU" :value cpu :display "${cpu}%" :action "./scripts/launch.sh system")
    (meter :name "GPU" :value {gpu.usage} :display {gpu.label} :action "./scripts/launch.sh gpu")
    (meter :name "RAM" :value ram :display "${ram}%" :action "./scripts/launch.sh system")
    (stat-row :name "GPU temperature" :value {gpu.temperature})
    (stat-row :name "Load 1 / 5 / 15m" :value {system_info.load})))

;; Specify both dimensions so Eww 0.6 does not retain a previous allocated width.
(defwidget process-row [process]
  (box :class "process-row" :orientation "v" :space-evenly false :spacing 4
    (box :space-evenly false :spacing 8
      (label :class "process-name" :text {process.name} :limit-width {layout.process_name_chars} :hexpand true :xalign 0 :tooltip {process.name})
      (label :class "micro" :style "font-size: ${layout.small_size}px;" :text {process.pid != "" ? "PID ${process.pid}" : ""} :halign "end"))
    (box :visible {process.pid != ""} :space-evenly false :spacing 16
      (label :text "CPU ${process.cpu}" :halign "start")
      (label :text "RAM ${process.memory}" :halign "start"))))

(defwidget processes-card [height]
  (box :class "card processes-card" :style "padding: ${layout.card_padding}px;" :vexpand true :orientation "v" :space-evenly false :spacing {layout.row_gap} :width {layout.card_width} :height {height - 2 * layout.card_padding - 4}
    (button :onclick "./scripts/launch.sh system" :tooltip "Open btop" (section-title :text "TOP PROCESSES"))
    (label :show-truncated false :class "column-heading" :style "font-size: ${layout.small_size}px;" :text "PROCESS / PID · CPU / RAM" :halign "start")
    (scroll :hscroll false :vscroll true :width 0 :height {layout.list_height} :vexpand true
      (box :orientation "v" :space-evenly false
        (for process in processes
          (process-row :process process))))))

(defwidget connectivity-card [height]
  (box :class "card connectivity-card" :style "padding: ${layout.card_padding}px;" :vexpand true :orientation "v" :space-evenly false :spacing {layout.row_gap} :width {layout.card_width} :height {height - 2 * layout.card_padding - 4}
    (button :onclick "./scripts/launch.sh network" :tooltip "View addresses and routes" (section-title :text "CONNECTIVITY"))
    (stat-row :name "Network" :value {network.state})
    (stat-row :name "Interface" :value {network.interface})
    (stat-row :name "Address" :value {network.ip})
    (stat-row :name "Tailscale IP" :value {network.tailscale})
    (stat-row :name "Tailscale" :value {vpn.tailscale_state})
    (stat-row :name "Proton VPN" :value {vpn.proton_state})
    (stat-row :name "Active VPNs" :value {vpn.summary})))

(defwidget media-control [action icon tooltip]
  (button :class {media.available ? "media-control" : "media-control media-unavailable"} :width {layout.media_control} :height {layout.media_control} :timeout "8s" :onclick "./scripts/media-control.sh ${action}" :tooltip tooltip
    (label :show-truncated false :text icon)))

(defwidget player-card [height]
  (box :class "card media-card" :style "padding: ${layout.card_padding}px;" :vexpand true :orientation "v" :space-evenly false :spacing {layout.row_gap} :width {layout.card_width} :height {height - 2 * layout.card_padding - 4}
    (section-title :text "PLAYER")
    (box :space-evenly false :spacing 16 :vexpand true
      (button :class "player-logo" :timeout "12s" :width {layout.album_size} :height {layout.album_size} :valign "center" :onclick "./scripts/media-control.sh open" :tooltip "Open the playing application"
        (box
          (image :visible {media.art != ""} :path {media.art != "" ? media.art : "media-placeholder.svg"} :image-width {layout.album_size} :image-height {layout.album_size})
          (label :show-truncated false :visible {media.art == ""} :style "font-size: ${layout.album_size / 2}px;" :text {media.icon})))
      (button :class "media-details" :timeout "12s" :onclick "./scripts/media-control.sh open" :tooltip "Open the playing application"
      (box :orientation "v" :space-evenly false :spacing 6 :hexpand true :valign "center"
        (label :show-truncated false :class "media-title" :hexpand true :xalign 0 :style "font-size: ${layout.media_title_size}px;" :text {media.title} :halign "fill" :width {layout.media_text_width} :height 0 :wrap true :tooltip {media.title})
        (label :show-truncated false :class "media-artist" :hexpand true :xalign 0 :text {media.artist != "" ? media.artist : media.player} :halign "fill" :width {layout.media_text_width} :height 0 :wrap true :tooltip {media.artist}))))
    (progress :class "media-progress" :value {media.progress})
    (box :space-evenly false :spacing 10
      (label :show-truncated false :class "media-time" :text "${media.position} / ${media.length}" :halign "start" :hexpand true)
      (media-control :action "previous" :icon "" :tooltip "Previous")
      (media-control :action "play-pause" :icon {media.status == "Playing" ? "" : ""} :tooltip "Play or pause")
      (media-control :action "next" :icon "" :tooltip "Next"))))

(defwidget shares-card [height]
  (box :class "card shares-card" :style "padding: ${layout.card_padding}px;" :vexpand true :orientation "v" :space-evenly false :spacing {layout.row_gap} :width {layout.card_width} :height {height - 2 * layout.card_padding - 4}
    (section-title :text "MOUNTED SHARES")
    (label :show-truncated false :class "subheading" :style "font-size: ${layout.small_size}px;" :text "SMB / NFS SHARES" :halign "start")
    (scroll :hscroll false :vscroll true :width 0 :height {layout.share_height} :vexpand true
      (box :orientation "v" :space-evenly false :spacing 6
        (for share in shares
          (label :show-truncated false :class "share-row" :text share :xalign 0 :wrap true :hexpand true :width {layout.card_width - 16} :height 0 :tooltip share))))))

(defwidget profile-controls []
  (box :orientation "v" :space-evenly false :spacing {layout.row_gap}
    (box :orientation {layout.card_width > 450 || layout.font_size <= 14 ? "h" : "v"} :space-evenly false :spacing {layout.row_gap}
      (for profile in {power_profile.available}
        (button :class {profile == power_profile.active ? "density-toggle profile-option profile-selected" : "density-toggle profile-option"} :onclick "./scripts/power-control.py set ${profile}" :timeout "20s" (label :text {profile == "power-saver" ? "Power Saver" : profile == "performance" ? "Performance" : "Balanced"} :style "font-size: ${layout.small_size}px;"))))
    (label :visible {power_profile.message != ""} :text {power_profile.message} :tooltip {power_profile.message} :wrap true :xalign 0 :width {layout.card_width - 32} :height 0 :style "font-size: ${layout.small_size}px;")))

(defwidget idle-setting [name field value]
  (box :space-evenly false :spacing {layout.row_gap}
    (label :text name :halign "start" :hexpand true)
    (button :active {idle.supported} :onclick "./scripts/idle-control.py adjust ${field} -1" :timeout "5s" (label :text "−"))
    (label :class "idle-number" :text {idle.known ? value : "—"} :width 34 :height 0)
    (button :active {idle.supported} :onclick "./scripts/idle-control.py adjust ${field} 1" :timeout "5s" (label :text "+"))
    (label :text "min" :class "micro")))

(defwidget power-card [height]
  (box :class "card power-idle-card" :style "padding: ${layout.card_padding}px;" :vexpand true :orientation "v" :space-evenly false :spacing {layout.row_gap} :width {layout.card_width} :height {height - 2 * layout.card_padding - 4}
    (section-title :text "POWER & IDLE")
    (label :text "${power_profile.source} · ${power_profile.active} · ${power_profile.mode}" :width {layout.card_width - 16} :height 0 :wrap true :xalign 0 :style "font-size: ${layout.small_size}px;")
    (box :space-evenly true :spacing {layout.row_gap}
      (button :class {power_tab == "idle" ? "profile-selected" : ""} :onclick "eww --config . update power_tab=idle" (label :text "Idle"))
      (button :class {power_tab == "power" ? "profile-selected" : ""} :onclick "eww --config . update power_tab=power" (label :text "Power")))
    (scroll :hscroll false :vscroll true :width 0 :height {layout.power_height} :vexpand true
      (box :orientation "v" :space-evenly false :spacing {layout.row_gap}
        (box :visible {power_tab == "idle"} :orientation "v" :space-evenly false :spacing {layout.row_gap}
          (idle-setting :name "Screen Off" :field "screen" :value {idle.screen})
          (idle-setting :name "Lock Screen" :field "lock" :value {idle.lock})
          (idle-setting :name "Auto Suspend" :field "suspend" :value {idle.suspend})
          (label :text {idle.message} :tooltip {idle.message} :wrap true :xalign 0 :width {layout.card_width - 16} :height 0 :style "font-size: ${layout.small_size}px;")
          (button :active {idle.supported && idle.dirty} :halign "end" :onclick "./scripts/idle-control.py apply" :timeout "25s" (label :text "Apply")))
        (box :visible {power_tab == "power"} :orientation "v" :space-evenly false :spacing {layout.row_gap}
          (box :visible {power.present} :orientation "v" :space-evenly false :spacing {layout.row_gap}
            (label :text "${power.battery} · ${power.status}" :halign "start")
            (label :visible {power.available} :text "Power draw: ${power.watts}" :halign "start")
            (label :visible {power.remaining != ""} :text {power.remaining} :halign "start"))
          (profile-controls))))))

(defwidget dashboard-grid []
  (literal :content dashboard_grid))

(defwidget app-shortcut [app pinned]
  (button :class {pinned ? "recent-app pinned-app" : "recent-app"} :timeout "10s"
    :onclick "./scripts/desktop.py launch ${app.id}"
    :onrightclick "./scripts/desktop.py pin ${app.id}"
    :tooltip {pinned ? "${app.name} · Right click to unpin" : "${app.name} · Right click to pin"}
    (box :orientation "v" :space-evenly false :spacing 6
      (image :icon {app.icon} :icon-size {layout.density == "compact" ? "large-toolbar" : "dnd"})
      (label :visible {layout.rail_labels} :text {app.name} :limit-width {layout.rail_name_chars} :width {layout.rail_content_width} :height 0 :wrap true :style "font-size: ${layout.app_name_size}px;"))))

(defwidget recent-apps-card []
  (box :class "card recent-rail" :style "padding: ${layout.card_padding}px;" :vexpand true :orientation "v" :space-evenly false :spacing {layout.row_gap} :width {layout.rail_width} :height 0 :vexpand true
    (scroll :hscroll false :vscroll true :vexpand true
      (box :orientation "v" :space-evenly false :spacing {layout.row_gap}
        (label :visible {arraylength(app_lists.pinned) > 0} :show-truncated false :class "card-title" :text {layout.rail_labels ? "PINNED" : ""} :style "font-size: ${layout.small_size}px;")
        (box :orientation "v" :space-evenly false :spacing {layout.row_gap}
          (for app in {app_lists.pinned} (app-shortcut :app app :pinned true)))
        (box :visible {arraylength(app_lists.pinned) > 0 && arraylength(app_lists.recent) > 0} :class "rail-divider" :height 1)
        (label :show-truncated false :class "card-title" :text {layout.rail_labels ? "RECENT" : ""} :style "font-size: ${layout.small_size}px;")
        (label :visible {arraylength(app_lists.recent) == 0} :show-truncated false :text {layout.rail_labels ? "Open an app to start" : "…"} :width {layout.rail_content_width} :height 0 :wrap true)
        (box :orientation "v" :space-evenly false :spacing {layout.row_gap}
          (for app in {app_lists.recent} (app-shortcut :app app :pinned false)))))))

(defwidget dashboard-content []
  (box :class "dashboard-surface ${refresh_status} idle-${idle.supported} profiles-${power_profile.supported}" :visible home_visible :space-evenly false :hexpand true :vexpand true
    (box :class {layout.density == "compact" ? "dashboard-panel compact" : "dashboard-panel comfortable"} :style "padding: ${layout.padding}px; font-size: ${layout.font_size}px;" :hexpand true :vexpand true :orientation "v" :space-evenly false :spacing {layout.gap} :vexpand true
      (box :class "header" :orientation {layout.columns == 1 ? "v" : "h"} :space-evenly false :spacing 16
        (box :orientation "v" :space-evenly false :hexpand true :spacing 4
          (label :class "title" :style "font-size: ${layout.title_size}px;" :xalign 0 :text {layout.hostname} :limit-width {layout.hostname_width} :tooltip {layout.hostname})
          (label :show-truncated false :class "subtitle" :style "font-size: ${layout.small_size}px;" :text "@@DASHBOARD_NAME@@" :halign "start"))
        (button :class "density-toggle" :timeout "6s" :onclick "./scripts/layout.py toggle" :tooltip {layout.density == "compact" ? "Switch to Comfortable: larger text, artwork and controls" : "Switch to Compact: readable text with tighter spacing"}
          (label :show-truncated false :text {layout.density == "compact" ? "Compact" : "Comfortable"}))
        (box :orientation "v" :space-evenly false :spacing 4
          (label :show-truncated false :class "clock" :style "font-size: ${layout.title_size}px;" :text clock :halign "end")
          (label :show-truncated false :class "date" :style "font-size: ${layout.small_size}px;" :text today :halign "end")))
      (box :orientation "h" :space-evenly false :spacing {layout.gap} :vexpand true
        (recent-apps-card)
        (box :hexpand true :vexpand true
          (dashboard-grid))))))

(defwindow dashboard
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "100%" :height "100%" :anchor "center")
  :stacking "bottom"
  :exclusive false
  :focusable false
  (dashboard-content))
